{
  "workflowId": "adl-toileting",
  "version": "1.0.0",
  "format": "ai-logic-json",
  "layer1_categoryMetadata": {
    "category": "ADL",
    "task": "Toileting",
    "audience": [
      "DSP",
      "Supervisor",
      "Clinical reviewer"
    ],
    "purpose": "Guide AI questioning and generate a supervisor-facing toileting note using structured answers, care-plan context, and safety escalation rules.",
    "documentationGoals": [
      "Capture the exact toileting support provided",
      "Capture prompt level, assistance level, and observed response",
      "Capture safety-sensitive findings and required escalation language",
      "Generate a concise but defensible toileting narrative"
    ],
    "requiredCarePlanContext": [
      "toileting_baseline",
      "continence_support_level",
      "transfer_support_level",
      "skin_integrity_risk",
      "uti_history_or_risk",
      "behavior_support_plan",
      "mobility_precautions",
      "supervision_requirements"
    ],
    "regulatoryRiskLevel": "high",
    "clinicalSensitivity": [
      "continence",
      "skin integrity",
      "infection signs",
      "fall risk",
      "behavioral refusal"
    ],
    "questioningConstraints": {
      "aiMayAskOnlyConfiguredQuestions": true,
      "aiMayAskConfiguredFollowUpsOnly": true,
      "aiMayNotInventClinicalConclusions": true,
      "aiMustUseNeutralDocumentationLanguage": true
    }
  },
  "layer2_questionRules": {
    "sequence": [
      "toileting_task_type",
      "outcome",
      "assistance_level",
      "engagement",
      "observed_response",
      "risks_and_protocols",
      "clinical_observations",
      "alerts_and_escalations",
      "free_note"
    ],
    "questions": [
      {
        "id": "toileting_task_type",
        "label": "What toileting support was provided?",
        "type": "single_select",
        "required": true,
        "options": [
          "Toilet transfer",
          "Prompt to toilet",
          "Brief change",
          "Perineal care",
          "Clothing adjustment",
          "Continence support",
          "Overnight toileting",
          "Other"
        ],
        "followUpRules": [
          {
            "when": "Other",
            "ask": "toileting_task_type_other"
          }
        ]
      },
      {
        "id": "toileting_task_type_other",
        "label": "Describe the toileting task.",
        "type": "free_text",
        "requiredWhen": {
          "questionId": "toileting_task_type",
          "equals": "Other"
        }
      },
      {
        "id": "outcome",
        "label": "What was the outcome?",
        "type": "single_select",
        "required": true,
        "options": [
          "Completed",
          "Partially completed",
          "Refused",
          "Not completed",
          "Interrupted",
          "Not needed",
          "Alternative completed"
        ]
      },
      {
        "id": "assistance_level",
        "label": "What assistance level was provided?",
        "type": "single_select",
        "required": true,
        "options": [
          "Independent",
          "Standby assist",
          "Supervision only",
          "Verbal prompt",
          "Visual prompt",
          "Redirection required",
          "Partial assist",
          "Full assist",
          "Two-person assist",
          "Dependent"
        ]
      },
      {
        "id": "engagement",
        "label": "How did the person engage during toileting support?",
        "type": "single_select",
        "required": true,
        "options": [
          "Engaged",
          "Hesitant",
          "Distracted",
          "Withdrawn",
          "Refused initially",
          "Re-engaged",
          "Cooperative",
          "Resistant"
        ]
      },
      {
        "id": "observed_response",
        "label": "What was the observed response?",
        "type": "multi_select",
        "required": true,
        "options": [
          "Tolerated well",
          "Tolerated with support",
          "Required repeated prompting",
          "Accepted redirection",
          "Demonstrated discomfort",
          "Declined further support",
          "No unusual response observed",
          "Other"
        ],
        "followUpRules": [
          {
            "whenIncludes": "Other",
            "ask": "observed_response_other"
          }
        ]
      },
      {
        "id": "observed_response_other",
        "label": "Describe the observed response.",
        "type": "free_text",
        "requiredWhenIncludes": {
          "questionId": "observed_response",
          "value": "Other"
        }
      },
      {
        "id": "risks_and_protocols",
        "label": "Which risks or protocols were active?",
        "type": "multi_select",
        "required": false,
        "options": [
          "Fall risk",
          "Gait belt required",
          "Two-person transfer required",
          "Universal precautions",
          "Skin breakdown risk",
          "Behavior support plan active",
          "Line-of-sight supervision required",
          "None"
        ]
      },
      {
        "id": "clinical_observations",
        "label": "Were any clinical observations noted?",
        "type": "multi_select",
        "required": false,
        "options": [
          "No unusual finding",
          "Skin redness",
          "Skin breakdown concern",
          "Foul-smelling urine",
          "Cloudy urine",
          "Pain with toileting",
          "Increased frequency",
          "Incontinence episode",
          "Constipation concern",
          "Blood observed",
          "Other"
        ],
        "followUpRules": [
          {
            "whenIncludes": "Other",
            "ask": "clinical_observations_other"
          }
        ]
      },
      {
        "id": "clinical_observations_other",
        "label": "Describe the clinical observation.",
        "type": "free_text",
        "requiredWhenIncludes": {
          "questionId": "clinical_observations",
          "value": "Other"
        }
      },
      {
        "id": "alerts_and_escalations",
        "label": "Were any alerts or follow-up needs present?",
        "type": "multi_select",
        "required": false,
        "options": [
          "None",
          "Pain reported",
          "Change in baseline",
          "Nurse notification needed",
          "Supervisor notification needed",
          "Incident follow-up needed"
        ]
      },
      {
        "id": "free_note",
        "label": "Add any extra toileting note guidance.",
        "type": "free_text",
        "required": false
      }
    ],
    "safetyTriggers": [
      {
        "id": "skin_concern_trigger",
        "whenAnySelected": [
          "Skin redness",
          "Skin breakdown concern"
        ],
        "sourceQuestionId": "clinical_observations",
        "flag": "skin_concern",
        "severity": "high",
        "requiredEscalations": [
          "Supervisor notification needed"
        ],
        "requiredNoteDirective": "The generated note must explicitly mention the skin concern, that staff observed it during toileting support, and that supervisor follow-up is required."
      },
      {
        "id": "uti_signs_trigger",
        "whenAnySelected": [
          "Foul-smelling urine",
          "Cloudy urine",
          "Pain with toileting",
          "Increased frequency",
          "Blood observed"
        ],
        "sourceQuestionId": "clinical_observations",
        "flag": "uti_signs",
        "severity": "high",
        "requiredEscalations": [
          "Nurse notification needed",
          "Supervisor notification needed"
        ],
        "requiredNoteDirective": "The generated note must explicitly mention observed signs concerning for possible UTI or urinary concern and state that nurse and/or supervisor follow-up is required."
      }
    ]
  },
  "layer3_noteGenerationContext": {
    "inputSources": {
      "structuredAnswers": true,
      "carePlanRow": true,
      "shiftContext": true,
      "runtimeAlerts": true,
      "supervisorInstructions": true
    },
    "compositionOrder": [
      "task and support rendered",
      "assistance and prompting",
      "engagement and observed response",
      "risks and protocols followed",
      "clinical observations",
      "alerts and follow-up"
    ],
    "toneProfiles": {
      "default": {
        "style": "professional, neutral, observational",
        "audience": "supervisor",
        "verbosity": "detailed"
      },
      "stable": {
        "style": "calm, routine, non-escalatory",
        "audience": "supervisor",
        "verbosity": "detailed"
      },
      "concern_heavy": {
        "style": "direct, concern-forward, supervisory",
        "audience": "supervisor",
        "verbosity": "detailed"
      },
      "follow_up_heavy": {
        "style": "clear, carry-forward focused, supervisory",
        "audience": "supervisor",
        "verbosity": "detailed"
      }
    },
    "systemPromptDirectives": [
      "Use the structured answers as facts.",
      "Do not invent support, symptoms, or interventions not provided in the answers or care-plan context.",
      "Write in a supervisor-facing documentation style.",
      "Include the support rendered, prompt/assist level, observed response, and any relevant precautions.",
      "If a safety flag is active, elevate it in the note and include required escalation language.",
      "If no unusual findings are present, avoid overdramatizing the note."
    ],
    "safetyFlagDirectives": {
      "skin_concern": {
        "mustMention": [
          "skin concern observed during toileting support",
          "staff response",
          "supervisor follow-up required"
        ],
        "toneOverride": "concern_heavy"
      },
      "uti_signs": {
        "mustMention": [
          "urinary concern or possible UTI signs observed",
          "staff response",
          "nurse follow-up required"
        ],
        "toneOverride": "follow_up_heavy"
      }
    },
    "outputSchema": {
      "summaryType": "single_supervisor_paragraph",
      "mustIncludeSections": [
        "support_rendered",
        "assistance_level",
        "observed_response"
      ],
      "optionalSections": [
        "clinical_observations",
        "follow_up"
      ]
    }
  }
}
