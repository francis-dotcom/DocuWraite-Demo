{
  "workflowId": "adl",
  "workflowLabel": "Activities of Daily Living",
  "architecture": {
    "model": "reusable-modules",
    "description": "Reusable modules are small behavioral and state engines that plug into any workflow or category.",
    "principle": "Use Lego blocks, not giant trees.",
    "runtimeFormula": [
      "Workflow",
      "Category",
      "Outcome Module",
      "Assistance Module",
      "Activation Rules",
      "Active Modules",
      "Module Execution"
    ],
    "executionFlow": [
      "Workflow",
      "Category",
      "Outcome State",
      "Assistance State",
      "Activation Rules",
      "Active Modules",
      "Module Execution"
    ],
    "activationRulesRef": [
      "adl-activation-rules",
      "module-execution-rules"
    ],
    "activationRationale": [
      "Rules run only after both outcome and assistance are known.",
      "completed + independent should stay minimal and avoid unnecessary safety or escalation prompts.",
      "completed + full_assist should activate safety and physical follow-up because more support context is needed.",
      "refused should activate refusal handling.",
      "incident_occurred should activate escalation and incident handling."
    ],
    "antiPatterns": [
      "giant duplicated trees",
      "giant JSON monsters",
      "hardcoded flows everywhere"
    ]
  },
  "activationExamples": [
    {
      "workflow": "adl",
      "category": "toileting",
      "outcome": "completed",
      "assistance": "full_assist",
      "thenActivate": [
        "assistance",
        "safety"
      ]
    },
    {
      "workflow": "adl",
      "category": "toileting",
      "outcome": "refused",
      "assistance": "verbal_prompt",
      "thenActivate": [
        "refusal"
      ]
    },
    {
      "workflow": "adl",
      "category": "toileting",
      "outcome": "incident_occurred",
      "assistance": "full_assist",
      "thenActivate": [
        "escalation",
        "incident",
        "safety"
      ]
    }
  ],
  "reusableModules": [
    {
      "moduleId": "outcome",
      "label": "Outcome Module",
      "purpose": "Determines what happened.",
      "registryRef": "adl-outcome-registry",
      "states": [
        "completed",
        "partially_completed",
        "refused",
        "not_completed",
        "not_needed",
        "incident_occurred"
      ]
    },
    {
      "moduleId": "assistance",
      "label": "Assistance Module",
      "purpose": "Determines how much support was required.",
      "registryRef": "assistance-registry",
      "states": [
        "independent",
        "partial_assist",
        "full_assist",
        "verbal_prompt"
      ]
    },
    {
      "moduleId": "refusal",
      "label": "Refusal Module",
      "purpose": "Handles refusal behavior consistently.",
      "states": [
        "refusal_reason",
        "redirection_attempted",
        "alternative_offered",
        "supervisor_notified",
        "escalation_required"
      ]
    },
    {
      "moduleId": "safety",
      "label": "Safety Module",
      "purpose": "Monitors immediate safety concerns.",
      "states": [
        "no_safety_concern",
        "fall_concern",
        "choking_concern",
        "environmental_hazard",
        "injury_observed"
      ]
    },
    {
      "moduleId": "risk_overlay",
      "label": "Risk Overlay Module",
      "purpose": "Injects risk-aware branching.",
      "states": [
        "fall_risk",
        "aspiration_risk",
        "seizure_risk",
        "elopement_risk",
        "skin_integrity_risk"
      ],
      "scope": "global"
    },
    {
      "moduleId": "escalation",
      "label": "Escalation Module",
      "purpose": "Determines if follow-up is needed.",
      "states": [
        "no_escalation",
        "monitor_only",
        "supervisor_notification",
        "incident_report_required",
        "emergency_protocol"
      ],
      "scope": "global"
    },
    {
      "moduleId": "behavioral_observation",
      "label": "Behavioral Observation Module",
      "purpose": "Captures emotional and behavioral context.",
      "states": [
        "calm",
        "cooperative",
        "anxious",
        "agitated",
        "aggressive",
        "withdrawn",
        "emotional_distress"
      ]
    },
    {
      "moduleId": "prompting",
      "label": "Prompting Module",
      "purpose": "Tracks cueing and prompting support.",
      "states": [
        "no_prompt",
        "verbal_prompt",
        "visual_prompt",
        "gestural_prompt",
        "repeated_prompting"
      ]
    },
    {
      "moduleId": "participation",
      "label": "Participation Module",
      "purpose": "Tracks engagement and compliance quality.",
      "states": [
        "fully_engaged",
        "minimally_engaged",
        "inconsistent_engagement",
        "refused_participation"
      ]
    },
    {
      "moduleId": "physical_observation",
      "label": "Physical Observation Module",
      "purpose": "Captures physical and clinical observations.",
      "states": [
        "pain_observed",
        "fatigue_observed",
        "skin_issue",
        "swelling",
        "abnormal_gait",
        "discomfort"
      ]
    },
    {
      "moduleId": "protocol",
      "label": "Protocol Module",
      "purpose": "Injects mandatory workflows.",
      "states": [
        "seizure_protocol",
        "aspiration_protocol",
        "diabetic_protocol",
        "oxygen_protocol"
      ],
      "scope": "overlay"
    },
    {
      "moduleId": "incident",
      "label": "Incident Module",
      "purpose": "Activates incident-specific runtime.",
      "states": [
        "near_fall",
        "choking_event",
        "aggressive_incident",
        "injury_event",
        "medication_error"
      ],
      "triggers": [
        "escalation",
        "incident workflow",
        "supervisor review"
      ]
    }
  ],
