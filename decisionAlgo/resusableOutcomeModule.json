{
  "registryId": "reusable-module-enterprise-map",
  "label": "Reusable Module Enterprise Map",
  "description": "Exhaustive reusable modules covering major clinical and documentation behaviors that can appear across many workflows.",
  "implementationGuidance": {
    "note": "Do not build all modules immediately. Use phased rollout.",
    "phaseOrder": [
      {
        "phase": 1,
        "modules": [
          "outcome",
          "assistance",
          "refusal",
          "safety"
        ],
        "goal": "Build the smallest safe runtime foundation first."
      },
      {
        "phase": 2,
        "modules": [
          "prompting",
          "participation",
          "behavioral_observation",
          "emotional_regulation",
          "risk_overlay",
          "physical_observation",
          "incident",
          "escalation",
          "follow_up"
        ],
        "goal": "Expand behavior, escalation, and risk-aware branching."
      },
      {
        "phase": 3,
        "modules": [
          "medication_support",
          "feeding_and_swallowing",
          "hygiene_observation",
          "supervision",
          "mobility_support",
          "communication",
          "sensory",
          "independence_skill",
          "adl_training",
          "protocol",
          "compliance",
          "ai_qa",
          "trend_monitoring"
        ],
        "goal": "Add protocols, QA, and longitudinal intelligence."
      }
    ]
  },
  "moduleGroups": [
    {
      "groupId": "core_state",
      "label": "Core State Modules",
      "moduleIds": [
        "outcome",
        "assistance",
        "prompting",
        "participation"
      ]
    },
    {
