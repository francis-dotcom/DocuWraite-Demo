    {
      "groupId": "skill_building",
      "label": "Skill-Building Modules",
      "moduleIds": [
        "independence_skill",
        "adl_training"
      ]
    },
    {
      "groupId": "protocol",
      "label": "Protocol Modules",
      "moduleIds": [
        "protocol",
        "compliance"
      ]
    },
    {
      "groupId": "quality_review",
      "label": "Quality and Review Modules",
      "moduleIds": [
        "ai_qa",
        "trend_monitoring"
      ]
    }
  ],
  "modules": [
    {
      "moduleNumber": 1,
      "moduleId": "outcome",
      "label": "Outcome Module",
      "purpose": "Determines what happened.",
      "states": [
        "completed",
        "partial",
        "refused",
        "not_completed",
        "not_needed",
        "incident_occurred"
      ],
      "usedIn": "almost_everywhere",
      "priority": "foundational"
    },
    {
      "moduleNumber": 2,
      "moduleId": "assistance",
      "label": "Assistance Module",
      "purpose": "Determines support level.",
      "states": [
        "independent",
        "verbal_prompt",
        "gestural_prompt",
        "partial_assist",
        "full_assist",
        "hand_over_hand"
      ],
      "usedIn": "everywhere",
      "priority": "foundational"
    },
    {
      "moduleNumber": 3,
      "moduleId": "prompting",
      "label": "Prompting Module",
      "purpose": "Tracks cueing.",
      "states": [
        "verbal_prompt",
        "visual_prompt",
        "repeated_prompting",
        "modeling",
        "redirection"
      ],
      "usedIn": "global",
      "priority": "high"
    },
    {
      "moduleNumber": 4,
      "moduleId": "participation",
      "label": "Participation Module",
      "purpose": "Tracks engagement.",
      "states": [
        "cooperative",
        "minimally_engaged",
        "inconsistent_engagement",
        "resistant",
        "fully_engaged"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 5,
      "moduleId": "refusal",
      "label": "Refusal Module",
      "purpose": "Reusable refusal handling across workflows.",
      "states": [
        "refusal_reason",
        "redirection_attempted",
        "alternative_offered",
        "escalation_needed"
      ],
      "priority": "foundational"
    },
    {
      "moduleNumber": 6,
      "moduleId": "behavioral_observation",
      "label": "Behavioral Observation Module",
      "purpose": "Captures emotional and behavioral presentation.",
      "states": [
        "calm",
        "anxious",
        "agitated",
        "aggressive",
        "withdrawn",
        "emotional_distress"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 7,
      "moduleId": "emotional_regulation",
      "label": "Emotional Regulation Module",
      "purpose": "Captures regulation, coping, and de-escalation context.",
      "states": [
        "coping_skills_used",
        "de_escalation_needed",
        "emotional_trigger_observed",
        "self_regulation_successful"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 8,
      "moduleId": "safety",
      "label": "Safety Module",
      "purpose": "Monitors immediate safety concerns.",
      "states": [
        "fall_concern",
        "unsafe_environment",
        "balance_issue",
        "supervision_concern"
      ],
      "priority": "foundational"
    },
    {
      "moduleNumber": 9,
      "moduleId": "risk_overlay",
      "label": "Risk Overlay Module",
      "purpose": "Injects risk-aware branching and middleware behavior.",
      "states": [
        "fall_risk",
        "aspiration_risk",
        "seizure_risk",
        "elopement_risk",
        "choking_risk"
      ],
      "scope": "middleware",
      "priority": "high"
    },
    {
      "moduleNumber": 10,
      "moduleId": "physical_observation",
      "label": "Physical Observation Module",
      "purpose": "Captures physical and clinical observations.",
      "states": [
        "pain",
        "fatigue",
        "swelling",
        "skin_issue",
        "abnormal_gait",
        "discomfort"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 11,
      "moduleId": "incident",
      "label": "Incident Module",
      "purpose": "Captures incident patterns that trigger escalation.",
      "states": [
        "near_fall",
        "injury",
        "choking_event",
        "aggressive_incident",
        "medication_error"
      ],
      "triggers": [
        "escalation"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 12,
      "moduleId": "escalation",
      "label": "Escalation Module",
      "purpose": "Determines whether higher-level follow-up is required.",
      "states": [
        "no_escalation",
        "supervisor_notified",
        "incident_report_needed",
        "emergency_response_activated"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 13,
      "moduleId": "follow_up",
      "label": "Follow-Up Module",
      "purpose": "Determines downstream monitoring and communication actions.",
      "states": [
        "monitor_only",
        "reassess_later",
        "notify_nurse",
        "notify_guardian",
        "document_trend"
      ],
      "priority": "high"
    },
    {
      "moduleNumber": 14,
      "moduleId": "medication_support",
      "label": "Medication Support Module",
      "purpose": "Captures medication support outcomes and concerns.",
      "states": [
        "medication_accepted",
        "medication_refused",
        "side_effects_observed",
        "adherence_concern"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 15,
      "moduleId": "feeding_and_swallowing",
      "label": "Feeding & Swallowing Module",
      "purpose": "Captures intake, swallowing, and aspiration-related support.",
      "states": [
        "swallowing_concern",
        "aspiration_signs",
        "adaptive_utensil_used",
        "food_texture_compliance"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 16,
      "moduleId": "hygiene_observation",
      "label": "Hygiene Observation Module",
      "purpose": "Captures hygiene-related observations and concerns.",
      "states": [
        "body_odor",
        "poor_hygiene",
        "skin_irritation",
        "grooming_concern"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 17,
      "moduleId": "supervision",
      "label": "Supervision Module",
      "purpose": "Captures supervision status and concern level.",
      "states": [
        "line_of_sight_maintained",
        "checks_completed",
        "wandering_concern",
        "supervision_level_maintained"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 18,
      "moduleId": "mobility_support",
      "label": "Mobility Support Module",
      "purpose": "Captures mobility support methods and compliance.",
      "states": [
        "gait_belt_used",
        "wheelchair_support",
        "transfer_support",
        "mobility_aid_compliance"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 19,
      "moduleId": "communication",
      "label": "Communication Module",
      "purpose": "Captures expressive, receptive, and assistive communication support.",
      "states": [
        "verbal_expression",
        "receptive_understanding",
        "communication_device_usage",
        "social_participation"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 20,
      "moduleId": "sensory",
      "label": "Sensory Module",
      "purpose": "Captures sensory processing and environmental trigger context.",
      "states": [
        "sensory_sensitivity",
        "overstimulation",
        "calming_supports_needed",
        "environmental_triggers"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 21,
      "moduleId": "independence_skill",
      "label": "Independence Skill Module",
      "purpose": "Captures skill-building toward independent task completion.",
      "states": [
        "task_sequencing",
        "independent_completion",
        "skill_retention",
        "adaptive_strategy_use"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 22,
      "moduleId": "adl_training",
      "label": "ADL Training Module",
      "purpose": "Captures ADL-specific skill acquisition and training.",
      "states": [
        "learning_dressing_routine",
        "toileting_independence",
        "grooming_skill_practice"
      ],
      "priority": "medium"
    },
    {
      "moduleNumber": 23,
      "moduleId": "protocol",
      "label": "Protocol Module",
      "purpose": "Injects mandatory protocol workflows.",
      "states": [
        "seizure_protocol",
        "diabetic_protocol",
        "oxygen_protocol",
        "aspiration_precautions"
      ],
      "priority": "later"
    },
    {
      "moduleNumber": 24,
      "moduleId": "compliance",
      "label": "Compliance Module",
      "purpose": "Captures compliance with required safety and protocol steps.",
      "states": [
        "protocol_followed",
        "ppe_used",
        "safety_steps_followed",
        "required_monitoring_completed"
      ],
      "priority": "later"
    },
    {
      "moduleNumber": 25,
      "moduleId": "ai_qa",
      "label": "AI QA Module",
      "purpose": "Runs quality review checks for contradictions, omissions, and inconsistencies.",
      "states": [
        "contradiction_detection",
        "missing_observations",
        "risk_omission",
        "timeline_inconsistency"
      ],
      "priority": "later"
    },
    {
      "moduleNumber": 26,
      "moduleId": "trend_monitoring",
      "label": "Trend Monitoring Module",
      "purpose": "Captures longitudinal pattern detection across repeated documentation.",
      "states": [
        "repeated_refusal",
        "recurring_falls",
        "hydration_decline",
        "behavioral_trend_escalation"
      ],
      "priority": "later"
    }
  ]
}
