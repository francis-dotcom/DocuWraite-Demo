      "label": "Safety and Risk Modules",
      "moduleIds": [
        "safety",
        "risk_overlay",
        "physical_observation",
        "incident"
      ]
    },
    {
      "groupId": "escalation",
      "label": "Escalation Modules",
      "moduleIds": [
        "escalation",
        "follow_up"
      ]
    },
    {
      "groupId": "clinical_support",
      "label": "Clinical Support Modules",
      "moduleIds": [
        "medication_support",
        "feeding_and_swallowing",
        "hygiene_observation"
      ]
    },
    {
      "groupId": "supervision",
      "label": "Supervision Modules",
      "moduleIds": [
